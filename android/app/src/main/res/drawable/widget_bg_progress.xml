<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded progress bar: translucent white track + rounded gradient fill.
     The fill is tinted at runtime to the live red->green color via
     setProgressTintList (SDK 31+); this drawable supplies the rounded shape. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#38FFFFFF" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />
                <solid android:color="#FFFFFFFF" />
            </shape>
        </clip>
    </item>
</layer-list>
